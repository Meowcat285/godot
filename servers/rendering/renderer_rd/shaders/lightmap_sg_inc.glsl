// Spherical Gaussian (SG) lightmaps: 12 lobes in lightmap space, one texture layer per lobe.
// Requires bicubic_filter_inc.glsl, M_PI and SAMPLER_LINEAR_CLAMP.
// The lobe layout must match modules/lightmapper_rd/lm_sg_inc.glsl (generated by lm_sg_basis.py).

#define LIGHTMAP_SG_LOBE_COUNT 12
#define LIGHTMAP_SG_SHARPNESS 4.0

const vec3 lightmap_sg_lobe_axes[LIGHTMAP_SG_LOBE_COUNT] = vec3[](
		vec3(0.00000000, 1.00000000, 0.00000000),
		vec3(0.89442719, 0.44721360, 0.00000000),
		vec3(0.27639320, 0.44721360, 0.85065081),
		vec3(-0.72360680, 0.44721360, 0.52573111),
		vec3(-0.72360680, 0.44721360, -0.52573111),
		vec3(0.27639320, 0.44721360, -0.85065081),
		vec3(0.72360680, -0.44721360, 0.52573111),
		vec3(-0.27639320, -0.44721360, 0.85065081),
		vec3(-0.89442719, -0.44721360, 0.00000000),
		vec3(-0.27639320, -0.44721360, -0.85065081),
		vec3(0.72360680, -0.44721360, -0.52573111),
		vec3(0.00000000, -1.00000000, 0.00000000));

// Cosine-weighted integral of a lobe with unit amplitude, for a normal at angle acos(p_mu_dot_n) from the lobe axis.
// Stephen Hill's fitted approximation: https://therealmjp.github.io/posts/sg-series-part-3-diffuse-lighting-from-an-sg-light-source/
float lightmap_sg_irradiance(float p_mu_dot_n) {
	const float lambda = LIGHTMAP_SG_SHARPNESS;
	const float c0 = 0.36;
	const float c1 = 1.0 / (4.0 * c0);
	const float eml = exp(-lambda);
	const float em2l = eml * eml;
	const float rl = 1.0 / lambda;
	const float scale = 1.0 + 2.0 * em2l - rl;
	const float bias = (eml - em2l) * rl - em2l;
	const float x = sqrt(1.0 - scale);
	const float integral = 2.0 * M_PI * (1.0 - em2l) * rl;

	float x0 = c0 * p_mu_dot_n;
	float x1 = c1 * x;
	float n = x0 + x1;
	float y = (abs(x0) <= x1) ? n * n / x : clamp(p_mu_dot_n, 0.0, 1.0);
	return (scale * y + bias) * integral;
}

// Integral of a lobe with unit amplitude against a normalized SG of sharpness p_sharpness around p_dir.
float lightmap_sg_convolve(vec3 p_axis, vec3 p_dir, float p_sharpness) {
	float d = length(LIGHTMAP_SG_SHARPNESS * p_axis + p_sharpness * p_dir);
	float sum = LIGHTMAP_SG_SHARPNESS + p_sharpness;
	float normalization = p_sharpness / (1.0 - exp(-2.0 * p_sharpness));
	return normalization * (exp(d - sum) - exp(-d - sum)) / max(d, 1e-4);
}

// Reads the lobes at p_uvw (z = first layer of the slice) and returns, in lightmap units:
// - r_diffuse: irradiance / PI for p_normal, like a regular lightmap sample.
// - r_specular: radiance prefiltered by the GGX lobe around p_reflection, for use as indirect specular light.
// All directions are in lightmap space.
void lightmap_sg_compute(texture2DArray p_tex, vec3 p_uvw, vec2 p_texture_size, bool p_bicubic, vec3 p_normal, vec3 p_reflection, float p_roughness, float p_NdotV, out vec3 r_diffuse, out vec3 r_specular) {
	// Spherical Gaussian approximation of the GGX distribution, warped around the reflection vector.
	// https://therealmjp.github.io/posts/sg-series-part-4-specular-lighting-from-an-sg-light-source/
	float alpha = max(p_roughness * p_roughness, 0.01);
	float ndf_sharpness = 2.0 / (alpha * alpha);
	float warped_sharpness = ndf_sharpness / (4.0 * max(p_NdotV, 1e-4));

	r_diffuse = vec3(0.0);
	r_specular = vec3(0.0);
	for (uint i = 0; i < LIGHTMAP_SG_LOBE_COUNT; i++) {
		vec3 uvw = p_uvw + vec3(0.0, 0.0, float(i));
		vec3 amplitude;
		if (p_bicubic) {
			amplitude = texture_array_bicubic(p_tex, uvw, p_texture_size).rgb;
		} else {
			amplitude = textureLod(sampler2DArray(p_tex, SAMPLER_LINEAR_CLAMP), uvw, 0.0).rgb;
		}

		vec3 axis = lightmap_sg_lobe_axes[i];
		r_diffuse += amplitude * lightmap_sg_irradiance(dot(axis, p_normal));
		r_specular += amplitude * lightmap_sg_convolve(axis, p_reflection, warped_sharpness);
	}

	r_diffuse = max(r_diffuse, vec3(0.0));
	// Lobes store radiance / PI.
	r_specular = max(r_specular * M_PI, vec3(0.0));
}

// How much the SG specular replaces reflection probes and sky reflections. The lobes are too wide to
// represent sharp reflections, so smooth surfaces keep using the reflection probes. At grazing angles the
// reflection vector nears the surface's horizon, where the lobes fade towards the (unlit) lower hemisphere.
float lightmap_sg_specular_blend(float p_roughness, float p_NdotV) {
	return smoothstep(0.25, 0.6, p_roughness) * smoothstep(0.0, 0.3, p_NdotV);
}
